# Database Connection (Neon PostgreSQL or Local PostgreSQL)
DB_URL=jdbc:postgresql://neondb_owner:YOUR_PASSWORD@ep-bold-waterfall-amecjnlr.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=YOUR_ROTATED_NEON_PASSWORD

# Groq API Key for LLM natural language query parsing
GROQ_API_KEY=gsk_your_groq_api_key_here

# Python AI Service URL (used by Spring Boot backend)
PYTHON_AI_URL=http://localhost:8000/api/parse-query

# Deployment Listen Ports (Zoho Catalyst / Heroku / Custom)
X_ZOHO_CATALYST_LISTEN_PORT=8081
